<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="pythonnet" Version="3.0.5" />
  </ItemGroup>

  <!-- 組込版Python（#102、python-embed/、.gitignore対象）が存在する場合のみ、
       実行ファイルと同じ出力フォルダへコピーする。配布物として exe と python-embed/ を
       同じ場所に揃えるため（Program.cs側もこの配置を前提に自動検出する）。 -->
  <ItemGroup>
    <None Include="python-embed\**" Condition="Exists('python-embed')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>python-embed\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <!-- 組込版Python・依存パッケージのライセンス条件（#102）を満たすため、
       サードパーティ ライセンス一覧も配布物に含める。 -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
